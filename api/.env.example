# Application
PORT=3000
WEB_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportman?schema=public

# Auth — generate a secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Email (Resend) — create a key at https://resend.com/api-keys
RESEND_API_KEY=
MAIL_FROM=SportNews <onboarding@resend.dev>

# Outbound article webhook (e.g. a Make.com "Custom webhook" scenario that
# posts to a WhatsApp channel). Fires when an article becomes published.
ARTICLE_WEBHOOK_URL=
ARTICLE_WEBHOOK_SECRET=

# Facebook Page posting (Meta Graph API). Create a Page Access Token with
# pages_manage_posts + pages_read_engagement in the Graph API Explorer.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v21.0

# MEGA file storage — the account used to store uploads
MEGA_EMAIL=
MEGA_PASSWORD=
# Optional folder inside the MEGA account (created when missing)
MEGA_FOLDER=sportnews
