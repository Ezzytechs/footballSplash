# API base URL. Leave blank in development to use the Vite proxy and the
# Vercel rewrite, both of which serve /api/v1 from the same origin.
VITE_API_URL=

# Endpoint that receives contact-page submissions. Any URL accepting a JSON
# POST works (Formspree, Web3Forms, Getform, your own API).
# Example: https://formspree.io/f/xxxxxxxx
VITE_CONTACT_FORM_ENDPOINT=

# API base URL for Vercel. Must include the /api prefix so the Vercel
# rewrite (source "/api/:path*" -> production API) applies.
VITE_API_URL=https://sportsplash.vercel.app/api
